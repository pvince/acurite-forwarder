{
  "name": "acurite-forwarder",
  "version": "1.0.0",
  "description": "Forwards Acurite requests to other dev servers",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node --tls-min-v1.0 -r ts-node/register src/app.ts",
    "test": "mocha --require ts-node/register --timeout 5000 \"test/**/*.test.js\"",
    "test:coverage": "c8 --all --include=src/**/*.ts --exclude=src/@types/** --reporter=text --reporter=html --reporter=lcov npm run test"
  },
  "author": "Paul Vincent",
  "license": "MIT",
  "dependencies": {
    "cross-env": "^7.0.3",
    "dateformat": "^4.6.3",
    "debug": "^4.3.4",
    "forwarder-http": "^3.2.0",
    "fs-extra": "^10.1.0",
    "selfsigned": "^2.0.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/dateformat": "^5.0.0",
    "@types/debug": "^4.1.7",
    "@types/fs-extra": "^9.0.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.11.49",
    "@types/proxyquire": "^1.3.31",
    "@types/selfsigned": "^2.0.1",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "@typescript-eslint/parser": "^5.33.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "eslint": "8.22.0",
    "eslint-plugin-jsdoc": "^39.3.6",
    "mocha": "^10.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4"
  }
}
